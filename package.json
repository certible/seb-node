{
  "name": "@certible/seb-node",
  "version": "3.1.0",
  "description": "TypeScript library for creating Safe Exam Browser (SEB) configuration files and handling Config Keys (server-side and browser)",
  "keywords": [
    "safe-exam-browser",
    "seb"
  ],
  "homepage": "https://github.com/certible/seb-node#readme",
  "bugs": {
    "url": "https://github.com/certible/seb-node/issues"
  },
  "license": "MPL-2.0",
  "author": "Certible <oberreiter@certible.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/certible/seb-node.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:ci": "vitest --run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-plist": "0.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
